# ==============================================================================
# KELİME ÖĞREN - ENVIRONMENT CONFIGURATION (.env)
# ==============================================================================

# 1. SUPABASE (Backend & Sync)
# Get these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key-here

# 2. BACKEND REST API
# Default: Android Emulator uses http://10.0.2.2:3000, Web/iOS/Desktop uses http://localhost:3000
# For physical devices, set your computer's local IP (e.g. http://192.168.1.100:3000):
API_BASE_URL=http://localhost:3000

# 3. RUNTIME DART DEFINES
# You can pass these when running flutter:
# flutter run --dart-define=API_BASE_URL=http://localhost:3000 --dart-define=SUPABASE_URL=https://xyz.supabase.co --dart-define=SUPABASE_ANON_KEY=abc
